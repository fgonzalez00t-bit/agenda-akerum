# Base de datos Postgres. Con Neon, `neon deploy` / `neon env pull` las escribe en .env.local:
# DATABASE_URL = conexión con pooler (la usa la app), DATABASE_URL_UNPOOLED = directa (para npm run db:setup)
DATABASE_URL=postgres://usuario:clave@host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=

# Acceso al panel de Pamela (/admin)
ADMIN_PASSWORD=cambiar-esta-clave
SESSION_SECRET=una-cadena-larga-y-aleatoria

# Datos del consultorio
BUSINESS_NAME=Dra. Pamela Bertiz
BUSINESS_TAGLINE=Medicina estética
BUSINESS_ADDRESS=
INSTAGRAM_URL=https://www.instagram.com/drapamelabertiz
WHATSAPP_NUMBER=59899696027
PUBLIC_URL=https://agenda-pamela.vercel.app

# Reglas de la agenda
TIMEZONE=America/Montevideo
# Código de país para armar el WhatsApp de las clientas que escriben su número sin él
COUNTRY_CODE=598
SLOT_STEP_MIN=30
DAYS_AHEAD=60
MIN_NOTICE_HOURS=12

# Aviso por WhatsApp a Pamela (CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_APIKEY=
